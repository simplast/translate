# Translation model (OpenAI-compatible chat completions endpoint)
TRANSLATE_BASE_URL=https://api.openai.com/v1
TRANSLATE_API_KEY=your_key_here
TRANSLATE_MODEL=gpt-4o-mini

# Examples / POS / sentence-skeleton model (OpenAI-compatible)
EXAMPLES_BASE_URL=https://api.openai.com/v1
EXAMPLES_API_KEY=your_key_here
EXAMPLES_MODEL=gpt-4o-mini

# Image generation
IMAGE_ENABLED=false
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=your_key_here
IMAGE_MODEL=dall-e-3
# Path appended to IMAGE_BASE_URL.
#   Standard OpenAI: /images/generations (default)
#   Tencent HY-Image-Lite: /api/image/lite
IMAGE_ENDPOINT=/images/generations
# Request/response shape.
#   "openai"        -> standard OpenAI images API
#   "tencent-lite"  -> Tencent HY-Image-Lite (rsp_img_type, negative_prompt, ...)
IMAGE_VENDOR=openai
